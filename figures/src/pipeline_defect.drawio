<mxfile host="app.diagrams.net" modified="2026-09-16T00:00:00.000Z" agent="qem-study" version="24.7.7">
  <diagram id="qem-pipeline" name="ZNE-REM pipeline and defect sites">
    <mxGraphModel dx="1100" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1"
                  arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="620"
                  math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>

        <mxCell id="t1" value="Budget-matched ZNE / REM pipeline — the two silent defect sites (red)"
                style="text;html=1;fontSize=16;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="16" width="1020" height="30" as="geometry"/></mxCell>

        <mxCell id="a" value="QAOA circuit&#10;(virtual qubits)"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#2a78d6;fontSize=12;"
                vertex="1" parent="1"><mxGeometry x="40" y="90" width="150" height="60" as="geometry"/></mxCell>

        <mxCell id="b" value="transpile to device&#10;coupling map + basis&#10;(layout chosen here)"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#2a78d6;fontSize=12;"
                vertex="1" parent="1"><mxGeometry x="230" y="90" width="170" height="60" as="geometry"/></mxCell>

        <mxCell id="lay" value="layout maps virtual q_i &#8594; physical q_&#960;(i)&#10;clbit c reads physical q_&#960;(c)"
                style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#eda100;fontSize=11;dashed=1;"
                vertex="1" parent="1"><mxGeometry x="210" y="172" width="210" height="48" as="geometry"/></mxCell>

        <mxCell id="c" value="global unitary folding&#10;scales (1, 3, 5)"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#2a78d6;fontSize=12;"
                vertex="1" parent="1"><mxGeometry x="440" y="90" width="160" height="60" as="geometry"/></mxCell>

        <mxCell id="d1" value="DEFECT 1&#10;strip measurements, then measure_all()&#10;&#8594; rebuilds clbit c &#8592; physical q_c&#10;&#8594; discards &#960;. Silent."
                style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fdecea;strokeColor=#e34948;fontSize=11;fontStyle=1"
                vertex="1" parent="1"><mxGeometry x="420" y="172" width="210" height="76" as="geometry"/></mxCell>

        <mxCell id="e" value="re-transpile&#10;optimization_level = 0&#10;(basis only, no cancellation)"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#2a78d6;fontSize=12;"
                vertex="1" parent="1"><mxGeometry x="640" y="90" width="175" height="60" as="geometry"/></mxCell>

        <mxCell id="f" value="execute&#10;(noisy simulator)"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#2a78d6;fontSize=12;"
                vertex="1" parent="1"><mxGeometry x="855" y="90" width="150" height="60" as="geometry"/></mxCell>

        <mxCell id="g" value="readout calibration&#10;2k circuits, |0&#9002;/|1&#9002; per qubit"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f7f0;strokeColor=#1baf7a;fontSize=12;"
                vertex="1" parent="1"><mxGeometry x="230" y="300" width="190" height="60" as="geometry"/></mxCell>

        <mxCell id="d2" value="DEFECT 2&#10;calibrate index i = VIRTUAL qubit i,&#10;but clbit i reads physical q_&#960;(i)&#10;&#8594; confusion matrix inverted on the&#10;wrong qubits. Silent."
                style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fdecea;strokeColor=#e34948;fontSize=11;fontStyle=1"
                vertex="1" parent="1"><mxGeometry x="210" y="382" width="230" height="88" as="geometry"/></mxCell>

        <mxCell id="h" value="invert tensored A,&#10;clip + renormalise"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f7f0;strokeColor=#1baf7a;fontSize=12;"
                vertex="1" parent="1"><mxGeometry x="470" y="300" width="160" height="60" as="geometry"/></mxCell>

        <mxCell id="i" value="Richardson extrapolation&#10;to zero noise"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3ec;strokeColor=#eb6834;fontSize=12;"
                vertex="1" parent="1"><mxGeometry x="680" y="300" width="175" height="60" as="geometry"/></mxCell>

        <mxCell id="j" value="estimate &#10;compare to exact&#10;noiseless value"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2f2f0;strokeColor=#52514e;fontSize=12;"
                vertex="1" parent="1"><mxGeometry x="895" y="300" width="150" height="60" as="geometry"/></mxCell>

        <mxCell id="ora" value="ORACLE used in the regression tests:&#10;global folding at odd scale is U U&#8224; U = U,&#10;so the IDEAL distribution must be unchanged.&#10;Any difference is a bug, at any noise level."
                style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef6ff;strokeColor=#2a78d6;fontSize=11;dashed=1;"
                vertex="1" parent="1"><mxGeometry x="680" y="182" width="325" height="80" as="geometry"/></mxCell>

        <mxCell id="bud" value="Budget rule: every method spends the SAME total shots B.&#10;unmitigated B &#183; ZNE B/3 per scale &#183; REM 0.8B circuits + 0.2B calibration"
                style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f7f5;strokeColor=#52514e;fontSize=11;"
                vertex="1" parent="1"><mxGeometry x="470" y="500" width="575" height="48" as="geometry"/></mxCell>

        <mxCell id="ef1" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#52514e;" edge="1" parent="1" source="a" target="b"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ef2" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#52514e;" edge="1" parent="1" source="b" target="c"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ef3" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#52514e;" edge="1" parent="1" source="c" target="e"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ef4" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#52514e;" edge="1" parent="1" source="e" target="f"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ef5" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#52514e;" edge="1" parent="1" source="b" target="g"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ef6" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#52514e;" edge="1" parent="1" source="g" target="h"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ef7" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#52514e;" edge="1" parent="1" source="f" target="h"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ef8" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#52514e;" edge="1" parent="1" source="h" target="i"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ef9" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#52514e;" edge="1" parent="1" source="i" target="j"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ed1" style="edgeStyle=none;html=1;dashed=1;strokeColor=#e34948;endArrow=none;" edge="1" parent="1" source="d1" target="c"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ed2" style="edgeStyle=none;html=1;dashed=1;strokeColor=#e34948;endArrow=none;" edge="1" parent="1" source="d2" target="g"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ed3" style="edgeStyle=none;html=1;dashed=1;strokeColor=#eda100;endArrow=none;" edge="1" parent="1" source="lay" target="b"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
